#!/bin/sh
# Git pre-commit hook: keep the tree formatted and lint-clean before it lands
# in a commit. Install with `make install-hooks` (or copy/symlink this file
# to .git/hooks/pre-commit yourself).
# SPDX-License-Identifier: GPL-2.0-or-later
set -e

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: make format-check"
if ! make format-check; then
  echo
  echo "pre-commit: formatting issues found - run 'make format' and re-stage." >&2
  exit 1
fi

echo "pre-commit: make lint"
if ! make lint; then
  echo
  echo "pre-commit: lint failed - fix the issues above." >&2
  exit 1
fi
